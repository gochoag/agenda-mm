# Configuración del Backend Flask (Agenda MM)

# Modo de ejecución de Flask
FLASK_APP=backend.app
FLASK_DEBUG=False

# Clave secreta para firma y verificación de tokens JWT (generar una cadena aleatoria y segura)
JWT_SECRET_KEY=cambiar-por-una-clave-secreta-de-mas-de-32-caracteres-en-produccion

# Ruta de la base de datos SQLite (opcional, por defecto backend/agenda.db)
DATABASE_PATH=backend/agenda.db

# Puerto para desarrollo local
PORT=5000
