# Configuración del Backend Flask (Agenda MM) para desarrollo local. Copia a backend/.env.

# Modo de ejecución de Flask
FLASK_APP=backend.app
FLASK_DEBUG=False

# Obligatoria, mínimo 32 caracteres (genera una con: openssl rand -base64 48). Sin ella la app no arranca.
JWT_SECRET_KEY=

# Postgres (producción / deploy-dev). Si no se define, se usa SQLite en DATABASE_PATH.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
DATABASE_PATH=backend/agenda.db

# Puerto para desarrollo local
PORT=5000
